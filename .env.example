# AegisAI-SOC Configuration
# Choose your active AI reasoning provider: 'heuristic', 'gemini', 'groq', 'ollama', 'openai'
AI_PROVIDER=heuristic

# Local Offline Ollama Settings (Free, runs on localhost)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Free Cloud API Keys (Optional - only required if chosen as provider)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Threat Intelligence API Keys (Optional - mock threat intelligence will be used if left blank)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
